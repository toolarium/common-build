#!/usr/bin/env bash

#########################################################################
#
# cb-image-version-resolver-test
#
# Tests for cb-image-version-resolver: verifies that Docker Hub image
# references are resolved to a pinned tag@digest reference.
#
# Copyright by toolarium, all rights reserved.
#
# This file is part of the toolarium common-build.
